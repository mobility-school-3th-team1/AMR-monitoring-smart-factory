# 통합 스택 (프로젝트 루트 compose.yml)
# 사용: cp .env.example .env 후 JWT_SECRET 설정
# 기동: docker compose up --build

# --- BE ---
# Base64, decodes to at least 32 bytes (HS256). Generate: openssl rand -base64 32
# 아래 값은 로컬 시연용 기본값(compose 미설정 시와 동일). 운영에서는 반드시 교체.
JWT_SECRET=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000
DEMO_USER_PASSWORD=demo123
BE_PORT=8080

# --- FE (브라우저 MQTT = 호스트 publish WS 포트) ---
VITE_MQTT_URL=ws://localhost:9001
FE_HOST_PORT=3000

# --- DAS·DB ---
MQTT_PORT=1883
MQTT_WS_PORT=9001
DB_ROOT_PASSWORD=root_pw
DB_NAME=scadadb
DB_PORT=3306
NODERED_PORT=1880
