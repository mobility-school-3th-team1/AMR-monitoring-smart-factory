    {
        "id": "f0982f7085ba7f5f",
        "type": "function",
        "z": "56b1ad1a6ae62587",
        "name": "read_hum_temp",
        "func": "// msg.payload에서 데이터 추출\n// payload[0] = 습도 Raw 데이터 (467)\n// payload[1] = 온도 Raw 데이터 (279)\nconst humRaw = msg.payload[0];\nconst tempRaw = msg.payload[1];\n\nlet humidity = 0;\nlet temperature = 0;\n\ntry {\n    // 1. 습도 계산 (C# 로직 동일)\n    humidity = humRaw / 10.0;\n\n    // 2. 온도 계산 (음수/2의 보수 처리 포함)\n    // Modbus 16비트 레지스터에서 0x8000(32768) 이상은 음수를 의미함\n    if (tempRaw >= 0x8000) {\n        temperature = -(0x10000 - tempRaw) / 10.0;\n    } else {\n        temperature = tempRaw / 10.0;\n    }\n\n    // 3. 결과 구조 재편성\n    msg.payload = {\n        humidity: parseFloat(humidity.toFixed(1)),\n        temperature: parseFloat(temperature.toFixed(1)),\n        timestamp: new Date().getTime() // DB 저장이나 차트 출력에 용이\n    };\n\n    return msg;\n} catch (e) {\n    node.error(\"데이터 파싱 중 오류 발생: \" + e.message);\n    return null;\n}",
