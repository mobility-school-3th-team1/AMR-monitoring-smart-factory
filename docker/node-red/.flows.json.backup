    {
        "id": "02b9c01c8ba4e89f",
        "type": "function",
        "z": "56b1ad1a6ae62587",
        "name": "set_global",
        "func": "// 전역변수 초기값 설정\nlet amr_01 = {\n    amr_id: 'AMR_BSA_01',\n    area: '조립 구역 1',\n    status: 'OPERATING',\n    pos_x: 0,\n    pos_y: 0,\n    yaw: 0,\n    load_weight: 400,\n    battery_pct: 94,\n    SOH_pct: 88,\n    battery_temp: 27.5,\n    updated_at: new Date().toISOString()\n};\n\nlet amr_02 = {\n    amr_id: 'AMR_BSA_02',\n    area: 'Lower Case 로딩 구역',\n    status: 'CHARGING',\n    pos_x: 0,\n    pos_y: 0,\n    yaw: 0,\n    load_weight: 0,\n    battery_pct: 46,\n    SOH_pct: 87,\n    battery_temp: 38.3,\n    updated_at: new Date().toISOString()\n};\n\nlet amr_03 = {\n    amr_id: 'AMR_BSA_03',\n    area: '조립 구역 2',\n    status: 'OPERATING',\n    pos_x: 0,\n    pos_y: 0,\n    yaw: 0,\n    load_weight: 500,\n    battery_pct: 82,\n    SOH_pct: 88,\n    battery_temp: 29.8,\n    updated_at: new Date().toISOString()\n};\n\nglobal.set('amr_01', amr_01);\nglobal.set('amr_02', amr_02);\nglobal.set('amr_03', amr_03);\n\nmsg.payload = '시뮬레이션 초기화';\nreturn msg;",
