    {
        "id": "b705e8a4c3d25f14",
        "type": "function",
        "z": "b701e8a4c3d25f10",
        "name": "build_environment",
        "func": "const areas = global.get('envSeed');\nif (!areas) {\n    node.warn('envSeed not initialized');\n    return null;\n}\n\nconst bump = (value, delta, min, max) => {\n    const next = Number(value) + delta;\n    return Math.min(max, Math.max(min, Math.round(next * 10) / 10));\n};\n\nObject.keys(areas).forEach((areaId) => {\n    const area = areas[areaId];\n    ['sensor1', 'sensor2', 'sensor3', 'sensor4'].forEach((sensorKey) => {\n        const sensor = area[sensorKey];\n        if (!sensor) return;\n        const sign = Math.random() < 0.5 ? -1 : 1;\n        sensor.temp = bump(sensor.temp, sign * 0.1, 20, 30);\n        sensor.humid = bump(sensor.humid, sign * 0.1, 28, 38);\n        sensor.particle = bump(sensor.particle, sign * 0.1, 15, 28);\n        sensor.cogas = bump(sensor.cogas, sign * 0.1, 3, 8);\n    });\n});\n\nglobal.set('envSeed', areas);\n\nmsg.payload = JSON.stringify({\n    timestamp: new Date().toISOString(),\n    areas\n});\nreturn msg;",
