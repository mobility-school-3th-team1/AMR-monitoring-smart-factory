    {
        "id": "b708e8a4c3d25f17",
        "type": "function",
        "z": "b701e8a4c3d25f10",
        "name": "build_amr_positions",
        "func": "const OPERATING_STATUS = 'OPERATING';\nconst EN_ROUTE_STATUS = 'EN_ROUTE_CHARGING';\nconst CHARGING_STATUS = 'CHARGING';\nconst CHARGING_X = 5;\nconst CHARGING_Y = 15;\nconst step = 1.5;\nconst ARRIVAL_TOLERANCE = 1.0;\n\nconst AMR_ZONES = {\n    'amr-01': { minX: 4, maxX: 23, minY: 14, maxY: 94 },\n    'amr-02': { minX: 26, maxX: 48, minY: 14, maxY: 94 },\n    'amr-03': { minX: 49, maxX: 77, minY: 14, maxY: 88 },\n    'amr-04': { minX: 4, maxX: 95, minY: 14, maxY: 94 },\n    'amr-05': { minX: 4, maxX: 23, minY: 14, maxY: 94 }\n};\n\nconst clamp = (value, min, max) => Math.min(max, Math.max(min, value));\nconst round1 = (value) => Math.round(value * 10) / 10;\n\nconst moveTowardCharge = (x, y) => {\n    let nextX = Number(x);\n    let nextY = Number(y);\n    const dx = CHARGING_X - nextX;\n    const dy = CHARGING_Y - nextY;\n    if (Math.abs(dx) <= step && Math.abs(dy) <= step) {\n        return { x: CHARGING_X, y: CHARGING_Y };\n    }\n    if (Math.abs(dx) >= Math.abs(dy)) {\n        nextX += Math.sign(dx) * Math.min(step, Math.abs(dx));\n    } else {\n        nextY += Math.sign(dy) * Math.min(step, Math.abs(dy));\n    }\n    return { x: round1(nextX), y: round1(nextY) };\n};\n\nconst moveInZone = (item, zone) => {\n    const stateKey = 'amrPath_' + item.amrId;\n    let state = global.get(stateKey) || { axis: 'x', dir: 1 };\n    let x = Number(item.x);\n    let y = Number(item.y);\n\n    if (state.axis === 'x') {\n        x += state.dir * step;\n        if (x <= zone.minX || x >= zone.maxX) {\n            x = clamp(x, zone.minX, zone.maxX);\n            state.dir *= -1;\n            state.axis = 'y';\n        }\n    } else {\n        y += state.dir * step;\n        if (y <= zone.minY || y >= zone.maxY) {\n            y = clamp(y, zone.minY, zone.maxY);\n            state.dir *= -1;\n            state.axis = 'x';\n        }\n    }\n\n    global.set(stateKey, state);\n    return { x: round1(x), y: round1(y) };\n};\n\nconst base = global.get('amrPositions') || [];\nconst statusesFromDb = global.get('amrStatusesFromDb') || {};\nconst mqttStopLatch = global.get('mqttStopLatch') || {};\n\nconst nextPositions = base.map((item) => {\n    const dbStatus = statusesFromDb[item.amrId] || 'IDLE';\n    const zone = AMR_ZONES[item.amrId] || AMR_ZONES['amr-01'];\n\n    if (dbStatus === CHARGING_STATUS) {\n        const atDock = Math.abs(Number(item.x) - CHARGING_X) <= ARRIVAL_TOLERANCE\n            && Math.abs(Number(item.y) - CHARGING_Y) <= ARRIVAL_TOLERANCE;\n        if (atDock) {\n            return { amrId: item.amrId, x: CHARGING_X, y: CHARGING_Y };\n        }\n        const moved = moveTowardCharge(item.x, item.y);\n        return { amrId: item.amrId, x: moved.x, y: moved.y };\n    }\n\n    if (dbStatus === EN_ROUTE_STATUS) {\n        const moved = moveTowardCharge(item.x, item.y);\n        return { amrId: item.amrId, x: moved.x, y: moved.y };\n    }\n\n    const canMove = dbStatus === OPERATING_STATUS && !mqttStopLatch[item.amrId];\n    if (!canMove) {\n        return { amrId: item.amrId, x: item.x, y: item.y };\n    }\n\n    const moved = moveInZone(item, zone);\n    return { amrId: item.amrId, x: moved.x, y: moved.y };\n});\n\nglobal.set('amrPositions', nextPositions);\nmsg.payload = JSON.stringify(nextPositions);\nreturn msg;",
