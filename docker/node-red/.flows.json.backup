    {
        "id": "b703e8a4c3d25f12",
        "type": "function",
        "z": "b701e8a4c3d25f10",
        "name": "init_mvp_seed",
        "func": "const sensor = (temp, humid, particle, cogas) => ({ temp, humid, particle, cogas });\nconst fourSensors = (t, h, p, c) => ({\n    sensor1: sensor(t, h, p, c),\n    sensor2: sensor(t + 1, h, p, c),\n    sensor3: sensor(t, h + 1, p + 1, c),\n    sensor4: sensor(t, h, p, c + 1)\n});\n\nconst envSeed = {\n    AREA_LOAD_LC: fourSensors(25, 33, 22, 5),\n    AREA_ASSEMBLE_01: fourSensors(24, 32, 21, 4),\n    AREA_ASSEMBLE_02: fourSensors(26, 34, 23, 6),\n    AREA_OUT_BSA: fourSensors(25, 33, 22, 5)\n};\n\nglobal.set('envSeed', envSeed);\nglobal.set('amrPositions', [\n    { amrId: 'amr-01', x: 25, y: 50 },\n    { amrId: 'amr-02', x: 40, y: 30 },\n    { amrId: 'amr-03', x: 55, y: 45 },\n    { amrId: 'amr-04', x: 70, y: 60 },\n    { amrId: 'amr-05', x: 15, y: 75 }\n]);\nglobal.set('mqttStopLatch', {});\nglobal.set('amrStatusesFromDb', {});\n\nmsg.payload = 'MVP seed initialized';\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 80,
        "wires": [
            []
        ]
    },
