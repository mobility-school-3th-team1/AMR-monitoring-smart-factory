    {
        "id": "8da395472d09e53c",
        "type": "function",
        "z": "56b1ad1a6ae62587",
        "name": "AMR_BSA_01",
        "func": "// AMR_BSA_01\nlet amr_tag = 'amr_01';\nlet amr = global.get(amr_tag);\namr.updated_at = new Date().toISOString();\n\n// 1. 배터리와 카운터 초기화 (없으면 초기값 설정)\nlet timer = context.get('timer') ?? 0;\n\n// 2. 타이머 증가 (1초에 한 번씩 실행되므로)\ntimer++;\n\n// 3. 10초가 되었을 때 로직 수행\nif (timer >= 10) {\n    if (amr.status === 'OPERATING') {\n        amr.battery_pct = Math.max(0, amr.battery_pct - 1); // 0% 밑으로 안 내려가게\n    } else if (amr.status === 'CHARGING') {\n        amr.battery_pct = Math.min(100, amr.battery_pct + 1); // 100% 위로 안 올라가게\n    }\n    timer = 0; // 타이머 리셋\n}\n\n// 4. 값 저장\nglobal.set(amr_tag, amr);\ncontext.set('timer', timer);\n\n// if (pos_x < 30) pos_x += 1; else pos_x = 0;\n// context.set('amr1_pos_x', pos_x);\n\n// if (pos_y < 30) pos_x += 1; else pos_y = 0;\n// context.set('amr1_pos_y', pos_y);\n\nmsg.payload = amr;\nreturn msg;",
