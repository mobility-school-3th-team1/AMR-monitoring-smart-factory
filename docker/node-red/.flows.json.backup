    {
        "id": "def8cf8b3d1cda61",
        "type": "modbus-read",
        "z": "56b1ad1a6ae62587",
        "name": "온습도 읽기",
        "topic": "sensor/temp_humid",
        "showStatusActivities": false,
        "logIOActivities": false,
        "showErrors": false,
        "showWarnings": true,
        "unitid": "1",
        "dataType": "HoldingRegister",
        "adr": "0",
        "quantity": "2",
        "rate": "1",
        "rateUnit": "s",
        "delayOnStart": false,
        "enableDeformedMessages": false,
        "startDelayTime": "",
        "server": "30a7902ccb1ce4eb",
        "useIOFile": false,
        "ioFile": "",
