    {
        "id": "b70be8a4c3d25f1a",
        "type": "function",
        "z": "b701e8a4c3d25f10",
        "name": "handle_emergency_stop",
        "func": "let command;\ntry {\n    command = typeof msg.payload === 'string' ? JSON.parse(msg.payload) : msg.payload;\n} catch (error) {\n    node.warn('Invalid command payload');\n    return null;\n}\n\nif (command.command !== 'emergencyStop' || !command.amrId) {\n    return null;\n}\n\nconst mqttStopLatch = global.get('mqttStopLatch') || {};\nmqttStopLatch[command.amrId] = true;\nglobal.set('mqttStopLatch', mqttStopLatch);\n\nnode.status({ fill: 'red', shape: 'dot', text: command.amrId + ' stopped' });\nreturn null;",
        "outputs": 1,
