# Copy to BE/.env and set values before docker compose up:
#   cp .env.example .env
#
# JWT_SECRET: Base64, decodes to at least 32 bytes (HS256).
#   Generate: openssl rand -base64 32
#   If a previous secret was committed to Git, rotate with a newly generated value.
#   Do not commit .env. Quote the value if it contains + or = characters.
JWT_SECRET=

JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Dev-only demo login (API spec); omit to skip seed user creation.
DEMO_USER_PASSWORD=demo123
