# Copy to BE/.env and adjust as needed: cp .env.example .env
#
# JWT_SECRET must be Base64-encoded and decode to at least 32 bytes (HS256).
# Generate: openssl rand -base64 32
#
# Example dev-only value (do not use in production):
JWT_SECRET=YW1yLXNtYXJ0LWZhY3RvcnktZG9ja2VyLWRldi1rZXkxMg==
JWT_EXPIRATION=3600000
