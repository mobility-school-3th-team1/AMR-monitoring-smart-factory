# Vite 개발 서버용 (FE/frontend/)
#
# Docker 없이 frontend 만 기동할 때:
#   cp .env.example .env
#
# FE/docker-compose.yml 사용 시:
#   FE/.env 를 compose 가 주입하거나, 본 파일을 .env 로 복사한다.
#   키는 FE/.env.example 과 동일해야 한다.

# MQTT — 호스트 브라우저에서 접속 (DAS publish 포트에 맞출 것, 예: 1883)
VITE_MQTT_URL=ws://localhost:1883

# 개발 편의(시연 필수 아님). true 이면 로그인 API 생략:
# VITE_AUTH_BYPASS=false
