# FE 녹화 시연 — Docker Compose 환경 변수
#
# 사용: FE/ 에서
#   cp .env.example .env
#   docker compose up --build
#
# FE/frontend/.env.example 과 동일 키를 유지한다.
# compose 가 frontend 서비스에 env_file 로 전달하거나,
# build.args 로 VITE_* 를 넘기도록 FE/docker-compose.yml 을 구성한다.

# MQTT (브라우저). DAS Mosquitto WebSocket publish (기본 9001, docker/README.md):
VITE_MQTT_URL=ws://localhost:9001

# 동일 Docker 네트워크에서 FE 컨테이너 내부만 MQTT 에 붙을 때(브라우저 아님):
# VITE_MQTT_URL=ws://mosquitto:1883

# FE docker-compose.yml — 호스트 publish 포트, BE compose 네트워크 이름
FE_HOST_PORT=3000
BE_DOCKER_NETWORK=be_default

# BE REST base URL 은 여기서 두지 않는다.
# nginx 가 compose 네트워크의 be:8080 으로 /api/v1 프록시한다.
